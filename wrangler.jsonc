{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Nombre del Worker: la página quedará en https://nocheosfera.<tu-subdominio>.workers.dev
  "name": "nocheosfera",
  "compatibility_date": "2026-11-24",
  // Solo archivos estáticos: Cloudflare sirve la carpeta dist (lo que genera npm run build)
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
